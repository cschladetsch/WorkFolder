#!/bin/bash
# WSL-specific startup script

# WSL-specific environment variables
export WSLENV=$WSLENV:WORK_FOLDER/p:WORK_BIN/p

# Set browser for WSL
export BROWSER="wslview"

# Helper function to convert WSL paths to Windows paths
wslpath_win() {
    wslpath -w "$1"
}

# Helper function to convert Windows paths to WSL paths
wslpath_wsl() {
    wslpath -u "$1"
}

# Alias for opening files/URLs in Windows
alias open="wslview"
alias xdg-open="wslview"

